# Copy to .env and fill in. NEVER commit .env or anything in certs/.
# See doc/10-aiven-setup.md
#
# Certificates: locally, point *_PATH at files in ./certs.
# On Vercel (no files), paste the PEM content into the matching *_CERT / *_KEY var instead.
# Content vars win over path vars when both are set.

# --- API ---
PORT=4000
NODE_ENV=development
ADMIN_TOKEN=change-me
LOW_STOCK_THRESHOLD=2

# --- Aiven PostgreSQL ---
DATABASE_URL=postgres://avnadmin:PASSWORD@HOST:PORT/defaultdb
PG_CA_PATH=./certs/aiven-ca.pem
PG_CA_CERT=
# Aiven Developer PG allows only 15 connections TOTAL (no pooler). Keep local dev at 3;
# the deployed web + workers use 5 each. Teammates: never run workers locally once cloud workers are up.
PG_POOL_MAX=3
# Aiven free PG = 15 connections (12 usable) shared by Vercel, workers and every laptop (doc/12 F1).
# Vercel production uses PG_POOL_MAX=1. Idle sockets close after PG_IDLE_TIMEOUT_MS; a request that
# can't get a connection within PG_CONNECT_TIMEOUT_MS gets 503 BUSY (the web client retries).
PG_IDLE_TIMEOUT_MS=5000
PG_CONNECT_TIMEOUT_MS=10000

# --- Aiven Kafka; used by workers + scripts only, never by the Vercel API ---
# Default: SASL/SCRAM over TLS (Aiven console → Kafka → Connection info → SASL). Use the SASL port.
KAFKA_BROKER=HOST:SASL_PORT
KAFKA_CA_PATH=./certs/aiven-ca.pem
KAFKA_CA_CERT=
KAFKA_SASL_USERNAME=avnadmin
KAFKA_SASL_PASSWORD=
KAFKA_SASL_MECHANISM=scram-sha-256
# Alternative: mTLS client certificate (leave KAFKA_SASL_USERNAME empty, use the client-cert port)
KAFKA_CERT_PATH=
KAFKA_KEY_PATH=
KAFKA_ACCESS_CERT=
KAFKA_ACCESS_KEY=
KAFKA_CLIENT_ID=stockhop
TOPIC_ORDERS=orders.placed
TOPIC_INVENTORY=inventory.changed
TOPIC_SMOKE=smoke
# Shopper clickstream (doc/14)
TOPIC_ACTIVITY=user.activity

# --- Aiven OpenSearch ---
OPENSEARCH_URL=https://avnadmin:PASSWORD@HOST:PORT
OPENSEARCH_INDEX_ALIAS=products
OPENSEARCH_INDEX_NAME=products_v9
# Partner shops (shop-name search, search inside a shop); built from PostgreSQL by the web process.
# OPENSEARCH_SHOPS_INDEX=shop_offers
OPENSEARCH_ACTIVITY_INDEX=stockhop-activity

# --- Razorpay Test Mode only; gateway connectivity checks, no real payments ---
test_api_key=
test_key_secret=

# Aiven for ClickHouse (doc/16): HTTPS service URI with credentials, on web AND workers
CLICKHOUSE_URL=
# COUPON_PERCENT_MAX=30
# Shopper accounts (doc/17). Email is simulated, so the sign-in code is shown on screen while true.
AUTH_DEMO_CODES=true
# Optional pepper for sign-in code hashes (any long random string).
AUTH_SECRET=
# Loyalty coupons only redeem for a shopper signed in with the coupon's email.
COUPON_REQUIRES_SIGN_IN=true
