{
  "name": "stockhop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "City-aware storefront on Aiven PostgreSQL, Kafka and OpenSearch",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,workers,web -c blue,magenta,green \"npm:dev:api\" \"npm:dev:workers\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/dev.ts",
    "dev:web": "vite",
    "dev:workers": "tsx watch server/workers/index.ts",
    "workers": "tsx server/workers/index.ts",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "smoke": "tsx scripts/smoke.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "workers:indexer": "tsx server/workers/index.ts --only=indexer",
    "workers:core": "tsx server/workers/index.ts --only=relay,notifier,monitor",
    "search:init": "tsx scripts/search-init.ts",
    "search:reindex": "tsx scripts/search-reindex.ts",
    "dashboards:setup": "tsx scripts/dashboards-setup.ts",
    "db:seed": "tsx scripts/seed.ts",
    "demo:reset": "npm run db:migrate && npm run search:init -- --recreate && npm run db:seed -- --yes",
    "kafka:topics": "tsx scripts/kafka-topics.ts",
    "check:sync": "tsx scripts/check-sync.ts",
    "start": "tsx server/main.ts",
    "e2e": "tsx scripts/e2e.ts",
    "e2e:retailer": "tsx scripts/e2e-retailer.ts",
    "demo:seed": "tsx scripts/demo-seed.ts",
    "e2e:shops": "tsx scripts/e2e-shops.ts",
    "payment:test": "tsx scripts/payment-gateway-test.ts",
    "checkout:race": "tsx scripts/checkout-race.ts",
    "payment:race": "tsx scripts/payment-race.ts",
    "demo:setup": "tsx scripts/demo-stock.ts",
    "sellers:seed": "tsx scripts/sellers-seed.ts",
    "prices:seed": "tsx scripts/price-spread-seed.ts",
    "clickhouse:seed": "tsx scripts/seed-clickhouse.ts",
    "products:more": "tsx scripts/more-products.ts",
    "search:catalog": "tsx scripts/search-catalog.ts",
    "model:fetch": "tsx scripts/fetch-model.ts",
    "accounts:test": "tsx scripts/accounts-test.ts",
    "dev:app": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "test:concurrency": "tsx scripts/concurrency-suite.ts",
    "drill:outage": "tsx scripts/drill.ts outage",
    "drill:replay": "tsx scripts/drill.ts replay",
    "load:test": "tsx scripts/load-test.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@opensearch-project/opensearch": "^3.10.0",
    "@vercel/functions": "3.10.5",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "gsap": "^3.13.0",
    "ioredis": "^5.4.2",
    "kafkajs": "^2.2.4",
    "lenis": "^1.3.27",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^6.4.6",
    "vitest": "^5.1.1"
  }
}
